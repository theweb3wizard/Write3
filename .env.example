# ── OpenRouter (AI Provider) ──────────────────────────────────────────
# PREMIUM key — funded by user revenue, used for paid-tier generations
OPENROUTER_API_KEY=sk-or-v1-...
# FREE key — $0 spend limit, used for free-tier generations
# If omitted, falls back to OPENROUTER_API_KEY (not recommended)
OPENROUTER_API_KEY_FREE=sk-or-v1-...

# ── Supabase Configuration ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── NowPayments (Crypto Payments) ────────────────────────────────────
NOWPAYMENTS_API_KEY=np_...
NOWPAYMENTS_IPN_SECRET=np_secret_...

# ── Admin (optional) ─────────────────────────────────────────────────
# Comma-separated Supabase user IDs that can see premium API balance
ADMIN_USER_IDS=user_id_1,user_id_2

# ── Application Settings ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
